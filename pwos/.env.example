# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The only email address allowed to sign in. Single-user app: anything else is rejected
# server-side before a magic link is ever sent.
PWOS_ALLOWED_EMAIL=you@example.com

# Public origin, used to build the magic-link callback URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
