# Copy to .env for local dev. Never commit .env.

# --- AI ---
GEMINI_API_KEY=            # aistudio.google.com/apikey — without it the AI routes return 503
GEMINI_MODEL=gemini-2.5-flash

# --- Auth ---
# Required in production; locally the server generates an ephemeral one.
JWT_SECRET=
# Seeds the admin login on first boot. Set it, or the server warns and uses admin123.
ADMIN_EMAIL=admin@kwba-agency.com
ADMIN_PASSWORD=

# --- Database ---
# Leave blank locally to use SQLite (./database.db). Set to the Postgres URL in production.
DATABASE_URL=

# --- Prospector ---
GOOGLE_PLACES_KEY=         # console.cloud.google.com, Places API (New)

# --- Optional: agent tools, each degrades gracefully if unset ---
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=
COMPANIES_HOUSE_KEY=

# --- Optional: file uploads ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional: outbound email ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_NOTIFY_EMAIL=

# --- Origins ---
FRONTEND_URL=http://localhost:3000
# Extra comma-separated origins allowed through CORS (e.g. a separately hosted audit page)
PROSPECTOR_ORIGINS=
PORT=3000
